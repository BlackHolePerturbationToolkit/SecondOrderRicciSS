Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"r0S", "[", "r0_", "]"}], ":=", 
   RowBox[{"ToString", "[", 
    RowBox[{"NumberForm", "[", 
     RowBox[{
      RowBox[{"N", "[", "r0", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Infinity]", ",", "1"}], "}"}]}], "]"}], "]"}]}], 
  ";"}]], "Input",
