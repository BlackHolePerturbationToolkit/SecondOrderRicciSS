Cell[TextData[{
 "We can ignore the regularization factor here as it contributes at higher \
order. (order ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Alpha]", "4"], TraditionalForm]],ExpressionUUID->
  "4d377a35-16b8-41a1-8af6-79dfc1a16dfe"],
 " in h, except  for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Alpha]\[Alpha]"], 
    RowBox[{"regfac", "~", 
     SuperscriptBox["\[Alpha]", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "3b1e5577-f29d-463c-bc95-5128ce986d95"],
 ")"
}], "Text",
