              RowBox[{"-", "a"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "M2chart"}], "}"}]}], "]"}], 
            RowBox[{"Basis", "[", 
             RowBox[{
              RowBox[{"-", "b"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "M2chart"}], "}"}]}], "]"}], 
            RowBox[{"g2", "[", 
             RowBox[{"a", ",", "b"}], "]"}]}], "]"}]}], "]"}]}], "]"}], "]"}],
      "&"}], "/@", "terms"}]}], ";"}]], "Input",
