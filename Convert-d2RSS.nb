Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"dsName", "[", 
    RowBox[{"i_", ",", "l_", ",", "m_"}], "]"}], ":=", 
   RowBox[{"\"\<src i=\>\"", "<>", 
    RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\< l=\>\"", "<>", 
    RowBox[{"ToString", "[", "l", "]"}], "<>", "\"\< m=\>\"", "<>", 
    RowBox[{"ToString", "[", "m", "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.7912247729645767`*^9, 3.791224806060794*^9}},
