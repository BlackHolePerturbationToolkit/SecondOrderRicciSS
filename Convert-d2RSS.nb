Cell[BoxData[
 RowBox[{
  RowBox[{"convert", "[", "r0_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "r", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Get", "[", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"indir", ",", 
         RowBox[{"\"\<r0_\>\"", "<>", 
          RowBox[{"r0S", "[", "r0", "]"}]}], ",", 
         RowBox[{"\"\<d2R-data-r0_\>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"N", "[", "r0", "]"}], "]"}], "<>", "\"\<.m\>\""}]}], 
        "}"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"r", "=", 
        RowBox[{"Import", "[", 
         RowBox[{
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\"\<r0_\>\"", "<>", 
              RowBox[{"ToString", "[", "r0", "]"}]}], ",", "\"\<d2R_SS\>\"", 
             ",", "\"\<src.h5\>\""}], "}"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<Datasets\>\"", ",", "\"\<r\>\""}], "}"}]}], "]"}]}], 
       ";"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"r", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"N", "[", 
         RowBox[{"r0", "+", "\[CapitalDelta]r"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[CapitalDelta]r", ",", 
          RowBox[{"-", "2"}], ",", "2", ",", 
          RowBox[{"1", "/", "100"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Quiet", "[", 
      RowBox[{
       RowBox[{"CreateDirectory", "[", 
        RowBox[{
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"outdir", ",", 
            RowBox[{"\"\<r0_\>\"", "<>", 
             RowBox[{"r0S", "[", "r0", "]"}]}], ",", "\"\<d2R_SS\>\""}], 
           "}"}], "]"}], ",", 
         RowBox[{"CreateIntermediateDirectories", "\[Rule]", "True"}]}], 
        "]"}], ",", 
       RowBox[{"CreateDirectory", "::", "filex"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"outdir", ",", 
          RowBox[{"\"\<r0_\>\"", "<>", 
           RowBox[{"r0S", "[", "r0", "]"}]}], ",", "\"\<d2R_SS\>\"", ",", 
          "\"\<src.h5\>\""}], "}"}], "]"}], ",", 
       RowBox[{"Flatten", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<r\>\"", "\[Rule]", "r"}], ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"dsName", "[", 
              RowBox[{"i", ",", "l", ",", "m"}], "]"}], "\[Rule]", 
             RowBox[{"d2RSS", "[", 
              RowBox[{
               RowBox[{"N", "[", "r0", "]"}], ",", "i", ",", "l", ",", "m"}], 
              "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", "7"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"l", ",", 
              RowBox[{"lmin", "[", "i", "]"}], ",", "lmax"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"m", ",", "l", ",", "0", ",", 
              RowBox[{"-", "2"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"dsName", "[", 
              RowBox[{"i", ",", "l", ",", "m"}], "]"}], "\[Rule]", 
             RowBox[{"d2RSS", "[", 
              RowBox[{
               RowBox[{"N", "[", "r0", "]"}], ",", "i", ",", "l", ",", "m"}], 
              "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "8", ",", "10"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"l", ",", 
              RowBox[{"lmin", "[", "i", "]"}], ",", "lmax"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"m", ",", 
              RowBox[{"l", "-", "1"}], ",", "0", ",", 
              RowBox[{"-", "2"}]}], "}"}]}], "]"}]}], "}"}], "]"}], ",", 
       "\"\<Datasets\>\""}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.8163553035605497`*^9, 3.816355314161818*^9}, {
