     RowBox[{
      RowBox[{"Expand", "[", "\[ScriptCapitalA]barMMAdam", "]"}], "/.", 
      "convertAdam"}], "//.", "moveIndices"}], "/.", "zeroDerivs"}]}], 
  ";"}]], "Input",
