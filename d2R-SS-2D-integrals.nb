                 "Sin", "|", "Cos", "|", "Tan", "|", "Sec", "|", "Csc", "|", 
                  "Cot"}], ")"}], "[", "_", "]"}], ")"}]}], "\[RuleDelayed]", 
             
             RowBox[{"TrigExpand", "[", "x", "]"}]}]}], "/.", 
