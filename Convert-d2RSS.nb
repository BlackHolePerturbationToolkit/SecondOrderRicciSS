         RowBox[{"\[Pi]", "/", "2"}], ",", 
         RowBox[{"\[Pi]", "/", "2"}]}], "]"}], 
       RowBox[{
        RowBox[{"data", "[", "r0", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "i", ",", 
          RowBox[{"l", "+", "1"}], ",", 
          RowBox[{"l", "+", "1", "+", "mp"}]}], "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"mp", ",", 
        RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}], "/.", 
    RowBox[{"Indeterminate", "\[Rule]", 
     RowBox[{"Sequence", "[", 
      RowBox[{"0.0", ",", "0.0"}], "]"}]}]}], "]"}]}]], "Input",
