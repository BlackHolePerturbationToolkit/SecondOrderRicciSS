Cell[BoxData[
 RowBox[{
  RowBox[{"d2R\[Mu]\[Nu]", "[", 
   RowBox[{"r_", ",", "r0_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
     "\[Chi]", ",", "\[Rho]", ",", "\[CapitalOmega]0", ",", "\[Alpha]", ",", 
      "\[Beta]", ",", "\[CapitalDelta]r", ",", "M", ",", "f", ",", 
