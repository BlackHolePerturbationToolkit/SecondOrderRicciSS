Cell[CellGroupData[{

Cell["\<\
Convert Adam\[CloseCurlyQuote]s expressions (move indices to canonical \
positions and change tensor and index names)\
\>", "Subsubsection",
 CellChangeTimes->{
  3.784381751235529*^9, {3.7844692645536823`*^9, 
   3.784469287944378*^9}},ExpressionUUID->"42d5931d-8641-4d95-86d7-\
2029170ed7a7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"convertAdam", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"hAB", "\[Rule]", "hbarP"}], ",", 
     RowBox[{"hab", "\[Rule]", "hbarP"}], ",", 
     RowBox[{"haA", "\[Rule]", "hbarP"}], ",", 
     RowBox[{"CDS2", "\[Rule]", "\[ScriptCapitalD]"}], ",", 
     RowBox[{
      RowBox[{"n", "[", "i_", "]"}], "\[RuleDelayed]", 
      RowBox[{"Basis", "[", 
       RowBox[{"i", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "M2chart"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"q", "\[Rule]", "g2"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"moveIndices", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"IndexRule", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"hbarP", "[", 
         RowBox[{
          RowBox[{"A_", "?", "UpIndexQ"}], ",", "b_"}], "]"}], "/;", 
        RowBox[{
         RowBox[{"VBundleOfIndex", "[", "A", "]"}], "\[Equal]", 
         "TangentS2"}]}], ",", 
       RowBox[{
        RowBox[{"\[CapitalOmega]", "[", 
         RowBox[{"A", ",", "B"}], "]"}], 
        RowBox[{"hbarP", "[", 
         RowBox[{
          RowBox[{"-", "B"}], ",", "b"}], "]"}]}]}], "]"}], ",", 
     RowBox[{"IndexRule", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"hbarP", "[", 
         RowBox[{"b_", ",", 
          RowBox[{"A_", "?", "UpIndexQ"}]}], "]"}], "/;", 
        RowBox[{
         RowBox[{"VBundleOfIndex", "[", "A", "]"}], "\[Equal]", 
         "TangentS2"}]}], ",", 
       RowBox[{
        RowBox[{"\[CapitalOmega]", "[", 
         RowBox[{"A", ",", "B"}], "]"}], 
        RowBox[{"hbarP", "[", 
         RowBox[{"b", ",", 
          RowBox[{"-", "B"}]}], "]"}]}]}], "]"}], ",", 
     RowBox[{"IndexRule", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"hbarP", "[", 
         RowBox[{
          RowBox[{"a_", "?", "UpIndexQ"}], ",", "B_"}], "]"}], "/;", 
        RowBox[{
         RowBox[{"VBundleOfIndex", "[", "a", "]"}], "\[Equal]", 
         "TangentM2"}]}], ",", 
       RowBox[{
        RowBox[{"g2", "[", 
         RowBox[{"a", ",", "b"}], "]"}], 
        RowBox[{"hbarP", "[", 
         RowBox[{
          RowBox[{"-", "b"}], ",", "B"}], "]"}]}]}], "]"}], ",", 
     RowBox[{"IndexRule", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"hbarP", "[", 
         RowBox[{"B_", ",", 
          RowBox[{"a_", "?", "UpIndexQ"}]}], "]"}], "/;", 
        RowBox[{
         RowBox[{"VBundleOfIndex", "[", "a", "]"}], "\[Equal]", 
         "TangentM2"}]}], ",", 
       RowBox[{
        RowBox[{"g2", "[", 
         RowBox[{"a", ",", "b"}], "]"}], 
        RowBox[{"hbarP", "[", 
         RowBox[{"B", ",", 
          RowBox[{"-", "b"}]}], "]"}]}]}], "]"}], ",", 
     RowBox[{"IndexRule", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", 
          RowBox[{"B_", "?", "UpIndexQ"}], "]"}], "[", "x_", "]"}], "/;", 
        RowBox[{
         RowBox[{"VBundleOfIndex", "[", "B", "]"}], "\[Equal]", 
         "TangentS2"}]}], ",", 
       RowBox[{
        RowBox[{"\[CapitalOmega]", "[", 
         RowBox[{"B", ",", "A"}], "]"}], 
        RowBox[{
         RowBox[{"\[ScriptCapitalD]", "[", 
          RowBox[{"-", "A"}], "]"}], "[", "x", "]"}]}]}], "]"}], ",", 
     RowBox[{"IndexRule", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"cd", "[", 
          RowBox[{"b_", "?", "UpIndexQ"}], "]"}], "[", "x_", "]"}], "/;", 
        RowBox[{
         RowBox[{"VBundleOfIndex", "[", "b", "]"}], "\[Equal]", 
         "TangentM2"}]}], ",", 
       RowBox[{
        RowBox[{"g2", "[", 
         RowBox[{"b", ",", "a"}], "]"}], 
        RowBox[{
         RowBox[{"cd", "[", 
          RowBox[{"-", "a"}], "]"}], "[", "x", "]"}]}]}], "]"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zeroDerivs", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"cd", "[", "_", "]"}], "[", 
       RowBox[{"\[CapitalOmega]", "[", "__", "]"}], "]"}], "\[Rule]", "0"}], 
     ",", 
     RowBox[{
      RowBox[{
       RowBox[{"\[ScriptCapitalD]", "[", "_", "]"}], "[", 
       RowBox[{"g2", "[", "__", "]"}], "]"}], "\[Rule]", "0"}]}], "}"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.784469291880712*^9, 3.784469321063445*^9}},
 CellLabel->"In[46]:=",ExpressionUUID->"80ac75a5-945c-41db-b2dc-35c837c73c9e"],

