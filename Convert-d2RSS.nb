Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"lmin", "[", "i_", "]"}], ":=", 
   RowBox[{"Switch", "[", 
    RowBox[{"i", ",", 
     RowBox[{"(", 
      RowBox[{"1", "|", "2", "|", "3", "|", "6"}], ")"}], ",", "0", ",", 
     RowBox[{"(", 
      RowBox[{"4", "|", "5", "|", "8", "|", "9"}], ")"}], ",", "1", ",", 
     RowBox[{"(", 
      RowBox[{"7", "|", "10"}], ")"}], ",", "2", ",", "_", ",", 
     RowBox[{"Abort", "[", "]"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.791224996351059*^9, 3.791225054882552*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"fb6dcd41-2ff3-4822-a7bb-cb27e913fcb8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"d2RSS", "[", 
   RowBox[{"r0_", ",", "i_", ",", "l_", ",", "m_"}], "]"}], ":=", 
  RowBox[{"ReIm", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"mp", "=", "0"}], "}"}], ",", 
       RowBox[{
        RowBox[{"WignerD", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"l", ",", "m", ",", "mp"}], "}"}], ",", "\[Pi]", ",", 
          RowBox[{"\[Pi]", "/", "2"}], ",", 
          RowBox[{"\[Pi]", "/", "2"}]}], "]"}], 
        RowBox[{
         RowBox[{"data", "[", "r0", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "i", ",", 
           RowBox[{"l", "+", "1"}], ",", 
           RowBox[{"1", "+", "mp"}]}], "]"}], "]"}]}]}], "]"}], "+", 
     RowBox[{"2", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"WignerD", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"l", ",", "m", ",", "mp"}], "}"}], ",", "\[Pi]", ",", 
           RowBox[{"\[Pi]", "/", "2"}], ",", 
           RowBox[{"\[Pi]", "/", "2"}]}], "]"}], 
         RowBox[{
          RowBox[{"data", "[", "r0", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "i", ",", 
            RowBox[{"l", "+", "1"}], ",", 
            RowBox[{"1", "+", "mp"}]}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"mp", ",", "1", ",", 
          RowBox[{"Min", "[", 
           RowBox[{"mpmax", ",", "l"}], "]"}]}], "}"}]}], "]"}]}]}], "/.", 
    RowBox[{"Indeterminate", "\[Rule]", 
     RowBox[{"Sequence", "[", 
      RowBox[{"0.0", ",", "0.0"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.791224501571711*^9, 3.791224540130681*^9}, 
   3.791224756399671*^9, {3.7913019522270937`*^9, 3.791301955082018*^9}, {
