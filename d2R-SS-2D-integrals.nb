            RowBox[{
             RowBox[{"-", "b_"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "M2chart"}], "}"}]}], "]"}], 
           RowBox[{"g2", "[", 
            RowBox[{"a_", ",", "b_"}], "]"}]}], ",", 
