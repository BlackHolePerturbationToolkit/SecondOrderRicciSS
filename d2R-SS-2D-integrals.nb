             RowBox[{"Cos", "[", "\[Beta]", "]"}], "2"], "\[Rule]", 
            RowBox[{"1", "-", 
             SuperscriptBox[
              RowBox[{"Sin", "[", "\[Beta]", "]"}], "2"]}]}]}], ",", 
          "\[Epsilon]", ",", 
