Cell[BoxData[
 RowBox[{
  RowBox[{"d2R\[ScriptCapitalA]\[ScriptCapitalM]\[ScriptCapitalM]hbar", "=", 
   RowBox[{
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Collect", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Collect", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Expand", "[", "#", "]"}], "/.", 
               RowBox[{"Thread", "[", 
                RowBox[{"sqcomps", "\[Rule]", 
                 RowBox[{"sqcomps", " ", 
                  SuperscriptBox["\[Epsilon]", 
                   RowBox[{"Range", "[", 
                    RowBox[{"Length", "[", "sqcomps", "]"}], "]"}]]}]}], 
                "]"}]}], ",", "\[Epsilon]", ",", "Simplify"}], "]"}], "/.", 
            RowBox[{
             RowBox[{"x", ":", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                 "Sin", "|", "Cos", "|", "Tan", "|", "Sec", "|", "Csc", "|", 
                  "Cot"}], ")"}], "[", "_", "]"}], ")"}]}], "\[RuleDelayed]", 
             
             RowBox[{"TrigExpand", "[", "x", "]"}]}]}], "/.", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"Cos", "[", "\[Beta]", "]"}], "2"], "\[Rule]", 
            RowBox[{"1", "-", 
             SuperscriptBox[
              RowBox[{"Sin", "[", "\[Beta]", "]"}], "2"]}]}]}], ",", 
          "\[Epsilon]", ",", 
          RowBox[{
