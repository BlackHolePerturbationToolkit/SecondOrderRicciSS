                    RowBox[{"dr\[Alpha]hb", "[", 
                    RowBox[{"i_", ",", "j_"}], "]"}], "\[RuleDelayed]", 
                    RowBox[{"dr\[Alpha]hbarseries", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ",", 
                   RowBox[{
