Cell[BoxData[
 RowBox[{
  RowBox[{"hbarseries", "=", 
   RowBox[{"Monitor", "[", 
    RowBox[{
     RowBox[{"MapIndexed", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"status", "=", "#2"}], ";", 
          RowBox[{"Simplify", "[", 
           RowBox[{
            RowBox[{"Series", "[", 
             RowBox[{
