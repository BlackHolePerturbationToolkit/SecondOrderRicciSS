Cell[BoxData[
 RowBox[{
  RowBox[{"r0s", "=", 
   RowBox[{"Sort", "[", 
    RowBox[{
     RowBox[{"Round", "[", 
      RowBox[{"10", 
       RowBox[{"(", 
        RowBox[{"ToExpression", "/@", 
         RowBox[{"StringReplace", "[", 
          RowBox[{
           RowBox[{"FileNames", "[", 
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{"indir", ",", "\"\<r0_*\>\""}], "}"}], "]"}], "]"}], 
           ",", 
           RowBox[{
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{"indir", ",", "\"\<r0_\>\""}], "}"}], "]"}], "\[Rule]", 
            "\"\<\>\""}]}], "]"}]}], ")"}]}], "]"}], "/", "10"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.8163310331519833`*^9, 3.816331124918276*^9}, {
