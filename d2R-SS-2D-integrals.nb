Cell[CellGroupData[{

Cell["Regularization factor", "Section",
 CellChangeTimes->{{3.783944903431419*^9, 
  3.78394490815891*^9}},ExpressionUUID->"39f92ef1-605c-4c6b-9643-\
735040a16e74"],

Cell["\<\
The regularization factor is a function of \[Alpha] only, but it is \
convenient to write it in terms of \[Rho] and \[CapitalDelta]r\
\>", "Text",
 CellChangeTimes->{{3.784382030846776*^9, 
  3.784382050872487*^9}},ExpressionUUID->"5ab5c1e8-5bfd-4a76-a3b9-\
3f716216f7af"],

Cell[BoxData[
 RowBox[{
  RowBox[{"reg", "[", 
   RowBox[{"n_", ",", "m_", ",", "y_"}], "]"}], ":=", 
  RowBox[{"1", "-", 
   RowBox[{
    FractionBox["n", "2"], 
    RowBox[{"Beta", "[", 
     RowBox[{"y", ",", 
      FractionBox["n", "2"], ",", 
      FractionBox["m", "2"]}], "]"}], " ", 
    RowBox[{"Binomial", "[", 
     RowBox[{
      FractionBox[
       RowBox[{"m", "+", "n", "-", "2"}], "2"], ",", 
      FractionBox["n", "2"]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.640636158964143*^9, 3.640636168668365*^9}, {
  3.640636288267384*^9, 3.640636318966119*^9}, {3.640636470725965*^9, 
  3.6406365150576477`*^9}, {3.640636562669217*^9, 3.640636568797758*^9}, {
  3.6439291362090597`*^9, 3.643929137272901*^9}},
 CellLabel->
  "In[226]:=",ExpressionUUID->"dfacc341-de0a-4fef-8630-99bef6910a94"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"mmax", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"norder", "=", "4"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"regfac", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"FunctionExpand", "[", 
     RowBox[{"reg", "[", 
      RowBox[{"norder", ",", "mmax", ",", 
       FractionBox[
        RowBox[{"1", "-", 
         RowBox[{"Cos", "[", 
          RowBox[{"\[Theta]p", "[", "]"}], "]"}]}], "2"]}], "]"}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"regfac\[Rho]\[CapitalDelta]r", "=", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"regfac", "/.", 
           RowBox[{
            RowBox[{"Cos", "[", 
             RowBox[{"\[Theta]p", "[", "]"}], "]"}], "\[Rule]", 
            RowBox[{"TrigExpand", "[", 
             RowBox[{"Cos", "[", 
              RowBox[{"2", "x"}], "]"}], "]"}]}]}], "/.", 
          RowBox[{"x", "\[Rule]", 
           RowBox[{
            RowBox[{"\[Theta]p", "[", "]"}], "/", "2"}]}]}], "/.", 
         RowBox[{
          RowBox[{"Cos", "[", 
           RowBox[{
            RowBox[{"\[Theta]p", "[", "]"}], "/", "2"}], "]"}], "\[Rule]", 
          SqrtBox[
           RowBox[{"1", "-", 
            SuperscriptBox[
             RowBox[{"Sin", "[", 
              RowBox[{
               RowBox[{"\[Theta]p", "[", "]"}], "/", "2"}], "]"}], 
             "2"]}]]}]}], "/.", 
        RowBox[{
         RowBox[{"\[Theta]p", "[", "]"}], "\[Rule]", "\[Alpha]"}]}], "/.", 
       "fromSin2\[Alpha]2"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Rho]", ",", "\[CapitalDelta]r"}], "}"}], ",", "Simplify"}], 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.6757175448748493`*^9, 3.6757175589045258`*^9}, {
  3.783943940883154*^9, 3.783943944293087*^9}},
 CellLabel->
  "In[227]:=",ExpressionUUID->"63633083-ecd8-4918-b3af-1853ba08d336"],

Cell[BoxData[
 RowBox[{
  RowBox[{"d\[Alpha]regfac\[Rho]\[CapitalDelta]r", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Collect", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Collect", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"D", "[", 
                 RowBox[{"#", ",", "\[Rho]"}], "]"}], 
                RowBox[{"Simplify", "[", 
                 RowBox[{
                  RowBox[{"D", "[", 
                   RowBox[{
                    RowBox[{"\[Rho]", "/.", "from\[Rho]"}], ",", "\[Alpha]"}],
                    "]"}], "/.", "to\[Rho]"}], "]"}]}], "+", 
               RowBox[{"D", "[", 
                RowBox[{"#", ",", "\[Alpha]"}], "]"}]}], ")"}], "/.", 
             "fromCos\[Alpha]"}], "/.", "fromSin\[Alpha]"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Rho]", ",", "\[CapitalDelta]r"}], "}"}], ",", 
           "Factor"}], "]"}], "/.", "fromCos\[Alpha]"}], "/.", 
        "fromSin\[Alpha]"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sin", "[", "\[Alpha]", "]"}], ",", "\[Rho]", ",", 
         "\[CapitalDelta]r"}], "}"}], ",", "Factor"}], "]"}], "&"}], "[", 
    "regfac\[Rho]\[CapitalDelta]r", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.765101047374695*^9, 3.765101058795446*^9}, {
   3.7651011101491137`*^9, 3.765101219201374*^9}, 3.765101333211618*^9, {
   3.765101439107242*^9, 3.7651014449374247`*^9}, {3.765101646263335*^9, 
   3.765101646629187*^9}, {3.7651027831803417`*^9, 3.765102795690352*^9}, {
   3.765103056598165*^9, 3.765103087706654*^9}, 3.765109425292068*^9, {
   3.783944339824162*^9, 3.783944342230721*^9}, {3.783944608618245*^9, 
   3.783944641869667*^9}, 
   3.795951886353889*^9},ExpressionUUID->"f51fb417-dbd2-433c-80a3-\
fe586933cfff"],

Cell[BoxData[
 RowBox[{
  RowBox[{"d\[Alpha]\[Alpha]regfac\[Rho]\[CapitalDelta]r", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Collect", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Collect", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"D", "[", 
                 RowBox[{"#", ",", "\[Rho]"}], "]"}], 
                RowBox[{"Simplify", "[", 
                 RowBox[{
                  RowBox[{"D", "[", 
                   RowBox[{
                    RowBox[{"\[Rho]", "/.", "from\[Rho]"}], ",", "\[Alpha]"}],
                    "]"}], "/.", "to\[Rho]"}], "]"}]}], "+", 
               RowBox[{"D", "[", 
                RowBox[{"#", ",", "\[Alpha]"}], "]"}]}], ")"}], "/.", 
             "fromCos\[Alpha]"}], "/.", "fromSin\[Alpha]"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Rho]", ",", "\[CapitalDelta]r"}], "}"}], ",", 
           "Factor"}], "]"}], "/.", "fromCos\[Alpha]"}], "/.", 
        "fromSin\[Alpha]"}], ",", 
       RowBox[{"{", 
        RowBox[{
