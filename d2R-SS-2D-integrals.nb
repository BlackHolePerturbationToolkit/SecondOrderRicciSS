Cell[BoxData[
 RowBox[{
  RowBox[{"RotateDeriv1", "=", 
   RowBox[{"IndexRuleDelayed", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"cd", "[", 
       RowBox[{"a_", "?", "DownIndexQ"}], "]"}], "[", "F___", "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"cd", "[", "a", "]"}], "[", "F", "]"}], "+", 
      RowBox[{
       RowBox[{"Basis", "[", 
        RowBox[{"a", ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "M2chart"}], "}"}]}], "]"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"alphadot", "[", "P", "]"}], 
          RowBox[{
           RowBox[{"\[ScriptCapitalD]", "[", 
            RowBox[{"-", "P"}], "]"}], "[", "F", "]"}]}], "+", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Indices", ",", "Dummies"}], "}"}], ",", 
           RowBox[{
            RowBox[{"Indices", "=", 
             RowBox[{
              RowBox[{"IndicesOf", "[", 
               RowBox[{"TangentS2", ",", "Free"}], "]"}], "[", "F", "]"}]}], 
            ";", 
            RowBox[{"Dummies", "=", 
             RowBox[{"DummyAs", "/@", 
              RowBox[{"Minus", "/@", "Indices"}]}]}], ";", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"CAB", "[", 
                RowBox[{
                 RowBox[{"Dummies", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], ",", 
                 RowBox[{"Indices", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], "]"}], 
               RowBox[{"(", 
                RowBox[{"F", "/.", 
                 RowBox[{
                  RowBox[{"Indices", "[", 
                   RowBox[{"[", "j", "]"}], "]"}], "\[Rule]", 
                  RowBox[{"-", 
                   RowBox[{"Dummies", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}]}]}], ")"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "1", ",", 
                RowBox[{"Length", "[", "Indices", "]"}]}], "}"}]}], "]"}]}]}],
           "]"}]}], ")"}]}]}]}], "]"}]}], ";"}]], "Input",
